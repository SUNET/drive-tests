# Generic Makefile for building and packaging a Nextcloud app which uses npm and
# Composer.
#
# Dependencies:
# * make
# * which
# * curl: used if phpunit and composer are not installed to fetch them from the web
# * tar: for building the archive
# * npm: for building and testing everything JS
#
# If no composer.json is in the app root directory, the Composer step
# will be skipped. The same goes for the package.json which can be located in
# the app root or the js/ directory.
#
# The npm command by launches the npm build script:
#
#    npm run build
#
# The npm test command launches the npm test script:
#
#    npm run test
#
# The idea behind this is to be completely testing and build tool agnostic. All
# build tools and additional package managers should be installed locally in
# your project, since this won't pollute people's global namespace.
#
# The following npm scripts in your package.json install and update the bower
# and npm dependencies and use gulp as build system (notice how everything is
# run from the node_modules folder):
#
#    "scripts": {
#        "test": "node node_modules/gulp-cli/bin/gulp.js karma",
#        "prebuild": "npm install && node_modules/bower/bin/bower install && node_modules/bower/bin/bower update",
#        "build": "node node_modules/gulp-cli/bin/gulp.js"
#    },

# .env holds initial config; auto-created from .env.example if missing.
# (GNU Make remakes an included file via its own rule before re-reading it.)
.env:
	cp .env.example .env

include .env

# .runtime.env holds app passwords generated by `make apppasswords` against a
# running instance; -include so it's not required to exist yet (see below).
-include .runtime.env

LOCALIP = $(shell hostname -i | awk '{print $$1; exit}')
# Re-evaluated (fresh random value) on every reference -- see bootstrappasswords.
GENPASS = $(shell tr -dc 'A-Za-z0-9!?%' < /dev/urandom | head -c 16)
NEXTCLOUD_VERSION = $(shell yq '.localhost.status.version' ../expected_localhost.yaml -r)

all: bootstrap
release: bootstrap

.PHONY: docker_kill
docker_kill:
	-docker compose down --remove-orphans

# docker-compose.yml bind-mounts these three paths into the nextcloud-app
# container; if they don't exist on the host, Docker silently creates empty
# *directories* there instead, which breaks Apache in a confusing way. Safe
# to run repeatedly -- skips generation once the files are already present.
.PHONY: certificates
certificates:
	@stray=""; \
	for f in /tmp/localhost.pem /tmp/nextcloud-ssl.conf /tmp/nextcloud-8443.conf; do \
		[ -d "$$f" ] && stray="$$stray $$f"; \
	done; \
	if [ -n "$$stray" ]; then \
		echo "Removing stray directories docker compose created at:$$stray (no cert files existed when it last started)"; \
		docker run --rm -v /tmp:/tmp busybox rm -rf $$stray; \
	fi
	@if [ -f /tmp/localhost.pem ] && [ -f /tmp/nextcloud-ssl.conf ] && [ -f /tmp/nextcloud-8443.conf ]; then \
		echo "Certificates already exist in /tmp, skipping (remove them, or run 'make cleanall', to regenerate)."; \
	else \
		echo "Generating self-signed certificate for https://localhost:8443 ..."; \
		openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
			-keyout /tmp/localhost-key.pem -out /tmp/localhost-cert.pem \
			-subj "/CN=localhost" \
			-addext "subjectAltName=DNS:localhost,IP:127.0.0.1"; \
		cat /tmp/localhost-cert.pem /tmp/localhost-key.pem > /tmp/localhost.pem; \
		rm -f /tmp/localhost-cert.pem /tmp/localhost-key.pem; \
		cp apache/nextcloud-ssl.conf /tmp/nextcloud-ssl.conf; \
		cp apache/nextcloud-8443.conf /tmp/nextcloud-8443.conf; \
		echo "Wrote /tmp/localhost.pem, /tmp/nextcloud-ssl.conf, /tmp/nextcloud-8443.conf"; \
	fi

.PHONY: bootstrap
bootstrap: docker_kill certificates
	docker compose -f docker-compose.yml build
	docker compose up -d
	@echo "Waiting for Nextcloud to become ready..."
	@i=0; \
	until ./occ_docker status >/dev/null 2>&1; do \
		i=$$((i+1)); \
		if [ $$i -ge 30 ]; then \
			echo "Timed out waiting for Nextcloud to become ready." >&2; \
			exit 1; \
		fi; \
		sleep 2; \
	done; \
	echo "Nextcloud is ready."
	-./occ_docker maintenance:install --admin-user='admin' --admin-pass='$(NEXTCLOUD_ADMIN_PASSWORD)' --database='mysql' --database-name='$(MYSQL_DATABASE)' --database-host='nextcloud-local-db' --database-user='$(MYSQL_USER)' --database-pass='$(MYSQL_PASSWORD)'

	./occ_docker config:system:set overwrite.cli.url --value="https://localhost:8443"
	./occ_docker config:system:set overwritehost --value="localhost:8443"
	./occ_docker config:system:set overwriteprotocol --value="https"

	./occ_docker config:system:set trusted_proxies --value="127.0.0.1,172.18.0.1,$(LOCALIP)"
	./occ_docker config:system:set trusted_domains 10 --value=localhost
	./occ_docker config:system:set trusted_domains 11 --value=127.0.0.1

	-./occ_docker app:install files_accesscontrol
	-./occ_docker app:install files_automatedtagging
	-./occ_docker app:install twofactor_webauthn
	-./occ_docker app:install richdocumentscode
	-./occ_docker app:install richdocuments
	./occ_docker config:app:set richdocuments wopi_allowlist --value="127.0.0.1,172.18.0.0/12"
	./occ_docker config:app:set richdocuments disable_certificate_verification --value="yes"
	./occ_docker config:app:set richdocuments wopi_url --value="http://collabora-server:9980"
	./occ_docker richdocuments:setup

	-./occ_docker app:install whiteboard
	-./occ_docker config:app:set whiteboard collabBackendUrl --value="http://localhost:3002"
	-./occ_docker config:app:set whiteboard jwt_secret_key --value="$(WHITEBOARD_JWT_SECRET_KEY)"

	-./occ_docker config:app:set bruteForce whitelist_1 --value="$$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}' nextcloud-local)"

	./occ_docker  app:enable twofactor_totp
	./occ_docker  app:enable files_external
	./occ_docker  app:enable tasks
	./occ_docker  app:enable calendar
	./occ_docker  app:enable polls
	./occ_docker  app:enable forms
	./occ_docker  app:enable deck
	./occ_docker  app:disable firstrunwizard

	wget https://github.com/SUNET/nextcloud-jupyter/releases/download/v0.1.2/integration_jupyterhub-0.1.2.tar.gz
	docker cp integration_jupyterhub-0.1.2.tar.gz nextcloud-local:/var/www/html/custom_apps
	docker exec -u www-data nextcloud-local /bin/bash -c "cd /var/www/html/custom_apps && tar -xzf integration_jupyterhub-0.1.2.tar.gz && rm integration_jupyterhub-0.1.2.tar.gz"
	docker exec -u www-data nextcloud-local /bin/bash -c "sed -i -e 's/max-version=\"29\"/max-version=\"31\"/g' /var/www/html/custom_apps/integration_jupyterhub/appinfo/info.xml"

	docker exec nextcloud-local /bin/bash -c "chown -R www-data:www-data /var/www/html/custom_apps/integration_jupyterhub"
	rm integration_jupyterhub-0.1.2.tar.gz
	-./occ_docker app:enable integration_jupyterhub
	-./occ_docker config:app:set integration_jupyterhub jupyter_url --value="http://localhost:8100"

	-./occ_docker  group:add forcemfa
	-./occ_docker  twofactorauth:enforce --on --group forcemfa
	./occ_docker  group:adduser forcemfa admin
	-docker exec -u www-data nextcloud-local /bin/bash -c "env OC_PASS=mfauserpassword /var/www/html/occ user:add --password-from-env --display-name='MFA User' --group='mfa' mfauser"
	-docker exec -u www-data nextcloud-local /bin/bash -c "env OC_PASS=nomfauserpassword /var/www/html/occ user:add --password-from-env --display-name='Ordinary User' nomfauser"
	-docker exec -u www-data nextcloud-local /bin/bash -c "env OC_PASS='$(NEXTCLOUD_OCS_PASSWORD_LOCALHOST_LOCALHOST)' /var/www/html/occ user:add --password-from-env --display-name='MFA User' --group='admin' _ocs_localhost"
	-docker exec -u www-data nextcloud-local /bin/bash -c "env OC_PASS='$(NEXTCLOUD_SELENIUM_MFA_PASSWORD_LOCALHOST_LOCALHOST)' /var/www/html/occ user:add --password-from-env --display-name='Selenium MFA User' --group='mfa' _selenium_localhost_mfa"
	-docker exec -u www-data nextcloud-local /bin/bash -c "env OC_PASS='$(NEXTCLOUD_SELENIUM_PASSWORD_LOCALHOST_LOCALHOST)' /var/www/html/occ user:add --password-from-env --display-name='Selenium User' _selenium_localhost"

	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=$(NEXTCLOUD_OCS_APP_PASSWORD_LOCALHOST_LOCALHOST) /var/www/html/occ user:auth-tokens:add --password-from-env _ocs_localhost"
	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=$(NEXTCLOUD_SELENIUM_APP_PASSWORD_LOCALHOST_LOCALHOST) /var/www/html/occ user:auth-tokens:add --password-from-env _selenium_localhost"
	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=$(NEXTCLOUD_SELENIUM_MFA_APP_PASSWORD_LOCALHOST_LOCALHOST) /var/www/html/occ user:auth-tokens:add --password-from-env _selenium_localhost_mfa"

	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=notimportant /var/www/html/occ user:auth-tokens:add --password-from-env _ocs_localhost"
	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=notimportant /var/www/html/occ user:auth-tokens:add --password-from-env _selenium_localhost"
	# -docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=notimportant /var/www/html/occ user:auth-tokens:add --password-from-env _selenium_localhost_mfa"

	# docker exec nextcloud-local-minio1 mc config host add myminio http://nextcloud-local-minio:9000 minioadmin
	docker exec nextcloud-local-minio1 mc alias set myminio http://nextcloud-local-minio:9000 $(MINIO_ROOT_USER) $(MINIO_ROOT_PASSWORD)
	-docker exec nextcloud-local-minio1 mc mb myminio/project-bucket
	-docker exec nextcloud-local-minio1 mc mb myminio/selenium-system
	-docker exec nextcloud-local-minio1 mc mb myminio/selenium-personal

	# Copy bucket configuration file to container and import mounts, with
	# MinIO credentials substituted in from .env
	sed -e "s|__MINIO_ROOT_USER__|$(MINIO_ROOT_USER)|g" -e "s|__MINIO_ROOT_PASSWORD__|$(MINIO_ROOT_PASSWORD)|g" files_external.json > /tmp/files_external.json
	docker cp /tmp/files_external.json nextcloud-local:/var/www/html/files_external.json
	-./occ_docker files_external:import files_external.json

	$(MAKE) apppasswords

.PHONY: docker-local
docker-local: bootstrap nextcloud-http-localhost printpasswords
	./occ_docker  twofactorauth:enforce --off --group forcemfa
	-firefox -new-tab http://localhost:8080/ -new-tab http://localhost:9001

.PHONY: commandtest
commandtest:
	docker exec -u www-data nextcloud-local /bin/bash -c "env NC_PASS=$(NEXTCLOUD_OCS_APP_PASSWORD_LOCALHOST_LOCALHOST) /var/www/html/occ user:auth-tokens:add --password-from-env _ocs_localhost"

.PHONY: expected
expected:
	cp -f ../expected_localhost_template.yaml ../expected_localhost.yaml
	python ../expected_localhost.py

.PHONY: jupyterhub
jupyterhub:
	cd jupyter-custom && docker build -t jupyterhub-local .

.PHONY: cleanall
cleanall:
	-./cleanall.sh
	-rm .env
	-rm -f .runtime.env
	-docker run --rm -v /tmp:/tmp busybox rm -rf /tmp/localhost.pem /tmp/nextcloud-ssl.conf /tmp/nextcloud-8443.conf
	-rm -rf /tmp/localhost*
	-rm -rf /tmp/nextcloud*
	-cd .. && rm expected_localhost.yaml

.PHONY: clean
clean:
	-./cleangentle.sh
	# .env holds initial config and is intentionally kept across `make clean`
	# (it's only removed by `make cleanall`) -- see .env.example.
	-rm -f .runtime.env
	-cd .. && rm expected_localhost.yaml

.PHONY: checkenv
checkenv:
	python ../environment_check.py ../requirements.txt -d

.PHONY: preparetest
preparetest: checkenv expected apppasswords

.PHONY: test
test: clean bootstrap checkenv expected acceptancetest

.PHONY: testall
testall: clean bootstrap checkenv expected acceptancetest logintest collaboratest

.PHONY: cleantest
cleantest: cleanall bootstrap checkenv expected acceptancetest

.PHONY: cleantestall
cleantestall: cleanall bootstrap checkenv expected acceptancetest logintest collaboratest

.PHONY: acceptancetest
acceptancetest:
	. ./.env; . ./.runtime.env; \
	cd ..; \
	python test_tests.py; \
	python test_status_cli.py; \
	python test_ocs.py; \
	python test_webdav.py
	-firefox ../test-reports-html/nextcloud-${NEXTCLOUD_VERSION}-acceptance.html

.PHONY: logintest
logintest:
	. ./.env; . ./.runtime.env; \
	cd ..; \
	python test_login_selenium.py
	-firefox ../test-reports-html/nextcloud-${NEXTCLOUD_VERSION}-selenium.html

.PHONY: collaboratest
collaboratest:
