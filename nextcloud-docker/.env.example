# Copy this to .env and adjust as needed -- or just run any `make` target,
# it will be created for you automatically if missing.
#
# .env holds this deployment's initial configuration. It is created once,
# survives `make clean`, and is only removed by `make cleanall`.
#
# App passwords that can only be generated against a *running* instance
# (OCS/Selenium app passwords) do NOT live here -- they are written to
# .runtime.env by `make apppasswords`, and regenerated on every test run.
#
# To (re)generate fresh values for the passwords/secrets below, run
# `make bootstrappasswords`. This is opt-in and never runs automatically,
# so repeated `make bootstrap`/`make test` runs keep using the same
# credentials until you deliberately rotate them.

# ---- Nextcloud (docker-compose.yml: nextcloud-app) ----
# Floating major-version tag; the exact patch actually deployed is recorded
# in expected_localhost.yaml by `make expected` after bootstrap.
export NEXTCLOUD_IMAGE_TAG=34
export NEXTCLOUD_ADMIN_PASSWORD=adminpassword

# ---- Nextcloud test runner ----
export NextcloudTestTarget=localhost
export NextcloudTestCustomers=localhost
export NextcloudTestRunner=html
export MFA_WAIT=3
export NEXTCLOUD_OCS_USER_LOCALHOST_LOCALHOST=_ocs_localhost
export NEXTCLOUD_OCS_PASSWORD_LOCALHOST_LOCALHOST=_ocs_localhost_password
export NEXTCLOUD_SELENIUM_USER_LOCALHOST_LOCALHOST=_selenium_localhost
export NEXTCLOUD_SELENIUM_PASSWORD_LOCALHOST_LOCALHOST=_selenium_localhost_password
export NEXTCLOUD_SELENIUM_MFA_USER_LOCALHOST_LOCALHOST=_selenium_localhost_mfa
export NEXTCLOUD_SELENIUM_MFA_PASSWORD_LOCALHOST_LOCALHOST=_selenium_localhost_mfa_password
# TOTP seed for the MFA test user (fed to pyotp.TOTP() by the test suite).
# NOT a plain password and not covered by `make bootstrappasswords` -- it
# must match whatever secret is actually enrolled in Nextcloud's
# twofactor_totp app for this user, which today only happens via the
# Selenium enrollment flow (helper_set_totp.py), not this file.
export NEXTCLOUD_SELENIUM_MFA_SECRET_LOCALHOST_LOCALHOST=

# ---- MariaDB (docker-compose.yml: db1, nextcloud-app) ----
export MYSQL_ROOT_PASSWORD=rootpass
export MYSQL_DATABASE=nextcloud
export MYSQL_USER=nextcloud
export MYSQL_PASSWORD=userpass

# ---- RustFS (docker-compose.yml: rustfs) ----
# files_external.json references these via __RUSTFS_ACCESS_KEY__/
# __RUSTFS_SECRET_KEY__ placeholders, substituted in at bootstrap time --
# safe to change/regenerate these without touching that file.
export RUSTFS_ACCESS_KEY=rustfsadmin
export RUSTFS_SECRET_KEY=rustfsadmin

# ---- Collabora (docker-compose.yml: collabora-server) ----
export COLLABORA_ADMIN_USER=admin
export COLLABORA_ADMIN_PASSWORD=adminpassword

# ---- Whiteboard (docker-compose.yml: whiteboard-server) ----
export WHITEBOARD_JWT_SECRET_KEY=some-random-key
